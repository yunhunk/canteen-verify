# ╔══════════════════════════════════════════════════════════════╗
# ║  食堂核销系统 · 环境配置（每一项都有标注，按标记操作即可）      ║
# ║                                                                ║
# ║  标记说明：                                                    ║
# ║   ★必改   → 上线前必须填真实值（有安全风险/环境相关）          ║
# ║   ◇可选   → 看情况改，默认值能跑                               ║
# ║   免改     → 保持默认即可，一般不用动                          ║
# ║                                                                ║
# ║  使用：cp .env.example .env → 只改【★必改】项 → bash deploy.sh ║
# ║  ⚠️ 真实 .env 含密钥，永远不要提交到 git / 发到群里            ║
# ╚══════════════════════════════════════════════════════════════╝


# ──────────────────────────────────────────────────────────────
# 一、数据库（MySQL 8）
# ──────────────────────────────────────────────────────────────

# ★必改【MYSQL_ROOT_PASSWORD】数据库最高管理员密码
#   是什么：MySQL root 账号密码，只在数据库首次建库时用
#   怎么配：自己编一个强密码（≥16位，大小写+数字+符号，别用示例值）
#   注意：仅在数据卷为空、首次启动时生效；之后改它要进数据库 ALTER USER
MYSQL_ROOT_PASSWORD=change-me-root-password   ◄◄◄ 第 1 处：改成你自己的强密码

# ★必改【DB_USER + DB_PASSWORD】业务账号（后端程序连数据库用的身份）
#   是什么：后端 API 日常读写数据库用的普通账号（不是 root）
#   怎么配：用户名随意（如 canteen）；密码自己编强密码
#   注意：首次启动会自动创建并授权；之后在 .env 改了密码，
#         数据库里的密码不会跟着变——要进容器同步 ALTER USER
DB_USER=canteen
DB_PASSWORD=change-me-db-password        ◄◄◄ 第 2 处：改成你自己的强密码

# 免改【DB_NAME】数据库名
#   是什么：业务数据存放的库
DB_NAME=canteen_verify

# ★必改【DB_SYNC】数据库表结构自动同步开关
#   是什么：1=启动时按代码里的实体自动建表/加列；0=关闭，表结构靠 SQL 迁移
#   怎么配：生产必须填 0！（自动同步可能误删列/改类型，有丢数据风险）
#   配套要求：DB_SYNC=0 时，改了代码实体必须同步执行迁移 SQL
#   （教训：线上曾因漏执行迁移导致员工登录报错）
DB_SYNC=0


# ──────────────────────────────────────────────────────────────
# 二、端口映射（宿主机侧；全部只绑 127.0.0.1，不暴露公网）
# ──────────────────────────────────────────────────────────────

# ◇可选【三个端口】宿主机上访问这些服务用的端口号
#   是什么：MYSQL=数据库 / REDIS=缓存 / API=后端接口
#   怎么配：只有宿主机上这些端口被占用时才需要换；公网访问走 443，与此无关
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
API_HOST_PORT=3100

# ★必改【REDIS_PASSWORD】Redis 访问密码
#   是什么：Redis 开启 requirepass 后，连接必须带此密码，否则报 NOAUTH
#   怎么配：自己编一个强密码（≥16位，大小写+数字+符号）
#   注意：改后需 docker compose up -d 重建 redis；后端 Redis 连接配置也要用此密码
REDIS_PASSWORD=change-me-redis-password   ◄◄◄ 第 5 处：改成你自己的强密码


# ──────────────────────────────────────────────────────────────
# 三、登录密钥（JWT）
# ──────────────────────────────────────────────────────────────

# ★必改【JWT_SECRET】登录令牌的签名密钥
#   是什么：员工/管理员登录后发的 token 就是用它签名的，泄露=任何人可伪造登录
#   怎么配：在服务器上执行 openssl rand -hex 32，把输出整串粘过来
#   注意：⚠️ 更换后所有已登录用户立即掉线，需重新登录（可接受就随时换）
JWT_SECRET=change-me-openssl-rand-hex-32  ◄◄◄ 第 3 处：服务器执行 openssl rand -hex 32 粘贴结果

# ◇可选【JWT_EXPIRES_IN】登录有效期
#   是什么：token 多久过期（s=秒 m=分 h=时 d=天）
#   怎么配：默认 7 天；想更严就 1d，员工一周输一次手机号而已
JWT_EXPIRES_IN=7d


# ──────────────────────────────────────────────────────────────
# 四、核销码
# ──────────────────────────────────────────────────────────────

# ◇可选【QRCODE_TTL】动态核销码有效期（秒）
#   是什么：员工出示的二维码多久作废（前端页面显示的 5 分钟就是它）
#   怎么配：默认 300 秒；调短更安全但员工来不及出示，建议别低于 120
QRCODE_TTL=300


# ──────────────────────────────────────────────────────────────
# 五、微信小程序（员工登录用真实微信身份）
# ──────────────────────────────────────────────────────────────

# 免改【WX_APPID】小程序 ID
#   是什么：小程序的身份证号，员工登录时微信用它识别是哪个小程序
#   从哪来：mp.weixin.qq.com →「开发」→「开发管理」→「开发设置」页最顶部
WX_APPID=wx7ac65adc8cc002de

# ★必改【WECHAT_APPSECRET】小程序密钥（当前值已是真实值则不用动）
#   是什么：配合 AppID 使用的服务端密钥，后端拿它调微信接口换用户身份
#   从哪来：同上页面点「生成/重置」，扫码验证后显示（只显示一次，当场复制）
#   ⚠️ 注意两点：
#   1. 在微信后台「重置」后旧密钥立即失效，必须同步改这里并重启：
#      docker compose restart api
#   2. 这串密钥等同登录凭证，泄露后他人可冒充你的小程序调微信接口
WECHAT_APPSECRET=change-me-wechat-secret ◄◄◄ 第 4 处：微信后台「开发设置」获取（或保持现有真实值）


# ──────────────────────────────────────────────────────────────
# 六、设备与杂项
# ──────────────────────────────────────────────────────────────

# ◇可选【ALLOW_LEGACY_DEVICE_TOKEN】老扫码设备过渡开关
#   是什么：1=允许旧版扫码 App 用明文设备密钥直连接口；0=一律走新绑定流程
#   怎么配：所有扫码设备都装了新版 App（v1.1.0+）就保持 0（更安全）
ALLOW_LEGACY_DEVICE_TOKEN=0

# 免改【TZ】时区
#   是什么：日志时间戳、核销时段判断都用它
TZ=Asia/Shanghai

# ◇可选【DOMAIN】部署域名（deploy.sh 签证书用）
#   是什么：一键部署脚本给这个域名申请 HTTPS 证书
#   怎么配：换域名时改这里 + 域名控制台加 A 记录指向服务器 IP + nginx 配置同步
DOMAIN=tuancan.gengle.xyz
