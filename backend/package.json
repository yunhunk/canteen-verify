{
  "name": "canteen-verify-backend",
  "version": "1.4.0",
  "description": "企业团餐核销系统后端（NestJS + TypeORM）",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "local": "cross-env LOCAL_MODE=1 nest start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:schema": "node scripts/check-schema.js",
    "check:miniapp": "node scripts/check-miniapp.js",
    "verify:qr": "node scripts/verify-qr.cjs",
    "verify:qr:e2e": "node scripts/verify-qr-e2e.cjs",
    "smoke": "node scripts/smoke.js",
    "verify": "npm run typecheck && npm run check:schema && npm run check:miniapp && npm run verify:qr && npm run smoke"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "mysql2": "^3.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.12.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "jsqr": "^1.4.0",
    "typescript": "^5.7.2"
  }
}
