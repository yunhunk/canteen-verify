/* 全局样式 —— 员工端视觉基线 */
page {
  background: #f4f6f8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 顶部渐变区 */
.hero {
  background: linear-gradient(135deg, #2b6cb0 0%, #4299e1 100%);
  padding: 48rpx 32rpx 72rpx;
  color: #ffffff;
  border-radius: 0 0 40rpx 40rpx;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 时段状态胶囊 */
.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.status-pill.open {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

.status-pill.closed {
  background: rgba(0, 0, 0, 0.18);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 数据格 */
.stat-row {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #2b6cb0;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

/* 列表行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  color: #4b5563;
}

.row-value {
  color: #111827;
  font-weight: 500;
}

/* 按钮 */
.btn-primary {
  background: #2b6cb0;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  text-align: center;
  font-weight: 500;
}

.btn-primary.disabled {
  background: #a0aec0;
}

.btn-ghost {
  background: #ffffff;
  color: #2b6cb0;
  border: 1rpx solid #2b6cb0;
  border-radius: 14rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}

/* 空态 */
.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

/* 时段标签 */
.window-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #ebf4ff;
  color: #2b6cb0;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.window-tag.active {
  background: #2b6cb0;
  color: #ffffff;
}

.window-tag.cross {
  background: #fffaf0;
  color: #b7791f;
}
