.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 汇总条 */
.summary {
  padding: 8rpx 8rpx 24rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.summary-num {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b6cb0;
  margin: 0 6rpx;
}

/* 列表卡片：去掉外层内边距，让分隔线通到边缘 */
.list-card {
  padding: 8rpx 32rpx;
}

.rec-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.rec-item:last-child {
  border-bottom: none;
}

/* 左侧日期块 */
.rec-date {
  width: 150rpx;
  flex-shrink: 0;
}

.rec-date-day {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}

.rec-date-week {
  font-size: 23rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

/* 中间门店信息 */
.rec-body {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.rec-store {
  font-size: 29rpx;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-meta {
  font-size: 23rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

/* 右侧状态标 */
.rec-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #276749;
  background: #ebf8f2;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx 0 12rpx;
  font-size: 24rpx;
  color: #a0aec0;
}

/* 空态补充 */
.empty-illust {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 25rpx;
  color: #b0b7c3;
}

/* 骨架屏 */
.skeleton-row {
  height: 40rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f4f6f8 25%, #eaeef3 37%, #f4f6f8 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  margin-bottom: 24rpx;
}

.skeleton-row.short {
  width: 55%;
  margin-bottom: 0;
}

@keyframes shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* 错误态 */
.error-card {
  text-align: center;
  color: #e53e3e;
  font-size: 27rpx;
}

.retry-btn {
  display: inline-block;
  padding: 14rpx 56rpx;
  margin-top: 28rpx;
}
