<view class="login-page">
  <view class="brand">
    <view class="brand-logo">餐</view>
    <view class="brand-title">员工用餐</view>
    <view class="brand-sub">扫码核销 · 次数查询</view>
  </view>

  <view class="card form-card">
    <!-- 静默登录中 -->
    <block wx:if="{{loading && needBind === null}}">
      <view class="loading-box">
        <view class="spinner"></view>
        <text class="loading-text">正在登录…</text>
      </view>
    </block>

    <!-- 需要绑定 -->
    <block wx:elif="{{needBind}}">
      <view class="form-title">首次使用，请绑定员工信息</view>
      <view class="form-tip">公司已为你开通账号，输入手机号即可绑定微信</view>

      <view class="field">
        <text class="field-label">手机号</text>
        <input
          class="field-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
          disabled="{{loading}}"
        />
      </view>

      <view class="field">
        <text class="field-label">工号（选填）</text>
        <input
          class="field-input"
          placeholder="不知道手机号时可填工号"
          value="{{employeeNo}}"
          bindinput="onEmployeeNoInput"
          disabled="{{loading}}"
        />
      </view>

      <view wx:if="{{errorMsg}}" class="error-msg">{{errorMsg}}</view>

      <view
        class="btn-primary {{loading ? 'disabled' : ''}}"
        bindtap="{{loading ? '' : 'onSubmit'}}"
      >
        {{loading ? '绑定中…' : '绑定并登录'}}
      </view>
    </block>

    <!-- 登录失败，可重试 -->
    <block wx:else>
      <view class="form-title">登录遇到问题</view>
      <view class="error-msg">{{errorMsg || '登录失败，请重试'}}</view>
      <view class="btn-primary" bindtap="trySilentLogin">重试</view>
    </block>
  </view>

  <view class="footer-tip">若无法登录，请联系公司管理员确认账号状态</view>
</view>
