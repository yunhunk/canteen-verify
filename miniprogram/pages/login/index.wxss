.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2b6cb0 0%, #4299e1 42%, #f4f6f8 42%);
  padding: 0 40rpx;
}

.brand {
  padding: 100rpx 0 60rpx;
  text-align: center;
  color: #ffffff;
}

.brand-logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  font-size: 56rpx;
  font-weight: 600;
}

.brand-title {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.brand-sub {
  font-size: 26rpx;
  opacity: 0.88;
  margin-top: 10rpx;
}

.form-card {
  margin-top: 20rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 10rpx;
}

.form-tip {
  font-size: 25rpx;
  color: #6b7280;
  margin-bottom: 36rpx;
}

.field {
  margin-bottom: 30rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
}

.field-input {
  background: #f7f9fb;
  border: 1rpx solid #e5e9ef;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
}

.error-msg {
  color: #e53e3e;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.loading-box {
  padding: 60rpx 0;
  text-align: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 24rpx;
  border: 4rpx solid #e5e9ef;
  border-top-color: #2b6cb0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  color: #6b7280;
  font-size: 28rpx;
}

.footer-tip {
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  padding: 40rpx 20rpx;
}
