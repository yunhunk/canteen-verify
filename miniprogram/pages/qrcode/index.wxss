.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 状态条 */
.status-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 32rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.status-bar.open {
  background: #ebf8f2;
  color: #276749;
}

.status-bar.closed {
  background: #fffaf0;
  color: #975a16;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-bar.open .status-dot {
  background: #38a169;
}

.status-bar.closed .status-dot {
  background: #d69e2e;
}

.qr-wrap {
  padding: 24rpx;
}

.qr-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.08);
  text-align: center;
}

/* 二维码区 */
.qr-box {
  width: 460rpx;
  height: 460rpx;
  margin: 0 auto;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx solid #eef1f5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.qr-image {
  width: 100%;
  height: 100%;
}

.qr-fallback {
  padding: 40rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.qr-fallback-label {
  font-size: 26rpx;
  color: #9ca3af;
  margin-bottom: 20rpx;
}

.qr-fallback-token {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: #2b6cb0;
  word-break: break-all;
  line-height: 1.7;
  background: #f7f9fb;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  letter-spacing: 1rpx;
}

.qr-fallback-hint {
  font-size: 23rpx;
  color: #a0aec0;
  margin-top: 24rpx;
  line-height: 1.6;
}

/* 已核销占位：与二维码同尺寸同位置，切换时视觉稳定 */
.qr-done-box {
  flex-direction: column;
  background: #f6fbf7;
  border: 2rpx dashed #bfe3c8;
}

.qr-done-badge {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #22a45d;
  color: #ffffff;
  font-size: 60rpx;
  line-height: 108rpx;
  text-align: center;
  font-weight: 600;
}

.qr-done-title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f7a45;
}

.qr-done-time {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b9c7c;
}

.qr-done-desc {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: #93b8a0;
  line-height: 1.6;
  padding: 0 36rpx;
}

.qr-skeleton {
  width: 460rpx;
  height: 460rpx;
  margin: 0 auto;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #f4f6f8 25%, #eaeef3 37%, #f4f6f8 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}

@keyframes shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.qr-loading-text {
  margin-top: 28rpx;
  color: #9ca3af;
  font-size: 26rpx;
}

/* 倒计时 */
.qr-countdown {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.countdown-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.countdown-value {
  font-size: 52rpx;
  font-weight: 600;
  color: #2b6cb0;
  font-variant-numeric: tabular-nums;
  letter-spacing: 2rpx;
}

.countdown-value.urgent {
  color: #dd6b20;
}

.countdown-value.done {
  color: #22a45d;
}

/* 本人剩余次数 + 餐标 */
.qr-meta {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
}

.qr-quota {
  font-size: 27rpx;
  color: #4a5568;
  font-weight: 500;
}

/* 只剩 1 次（或 0 次）时变色提醒，别等核销时才发现不够 */
.qr-quota.low {
  color: #dd6b20;
}

.qr-meal {
  font-size: 27rpx;
  color: #718096;
  margin-left: 10rpx;
}

.qr-actions {
  margin-top: 36rpx;
  padding: 0 40rpx;
}

.qr-tip {
  margin-top: 32rpx;
  font-size: 23rpx;
  color: #a0aec0;
  line-height: 1.7;
}

/* 错误态 */
.qr-error {
  padding: 60rpx 20rpx;
}

.qr-error-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.qr-error-msg {
  font-size: 26rpx;
  color: #e53e3e;
  margin-bottom: 36rpx;
}

.qr-retry {
  display: inline-block;
  padding: 16rpx 60rpx;
}

/* 非核销时段：不出码，改为时段说明 */
.qr-closed {
  padding: 40rpx 8rpx 16rpx;
}

.qr-closed-icon {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.qr-closed-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.qr-closed-desc {
  font-size: 25rpx;
  color: #6b7280;
  line-height: 1.75;
  padding: 0 24rpx;
  margin-bottom: 36rpx;
}

.qr-closed-windows {
  background: #fffaf0;
  border: 1rpx solid #fbd38d;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  text-align: left;
}

.qr-closed-label {
  font-size: 24rpx;
  color: #975a16;
  margin-bottom: 18rpx;
  font-weight: 600;
}

.qr-closed-window {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #f0d9ae;
}

.qr-closed-window:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.qr-closed-window-name {
  font-size: 27rpx;
  color: #8b6b32;
}

.qr-closed-window-time {
  font-size: 27rpx;
  color: #975a16;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.qr-closed-next {
  margin-top: 24rpx;
  font-size: 25rpx;
  color: #2b6cb0;
  background: #ebf4ff;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
}

.qr-refresh-btn {
  display: inline-block;
  margin: 0 10rpx;
  padding: 18rpx 44rpx;
}

